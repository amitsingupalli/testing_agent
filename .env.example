# Copy this file to .env (never committed) and fill in what you use.
# testing-agent reads these from your shell environment; the file is a
# convenience for `dotenv`-style loaders and human reference.

# Test generation backends (Phase 2) — pick ONE, or let `--backend auto` decide.
# Without any of these, generation falls back to the offline gap manifest.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: override the opencode CLI used by the `opencode` backend.
# OPENCODE_CMD=opencode
